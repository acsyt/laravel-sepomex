{
    "name": "acsyt/laravel-sepomex",
    "description": "Servicio Postal Mexicano (Sepomex) not official laravel library",
    "keywords": [
        "laravel",
        "sepomex",
        "mexico"
    ],
    "license": "MIT",
    "support": {
        "source": "https://github.com/acsyt/laravel-sepomex"
    },
    "type": "library",
    "version": "5.1.0",
    "authors": [
        {
            "name": "Aftab Hussain Miranda",
            "email": "wafto.mx@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zip": "*",
        "illuminate/database": "^13.23",
        "illuminate/support": "^13.23",
        "symfony/browser-kit": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.16",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Wafto\\Sepomex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wafto\\Sepomex\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wafto\\Sepomex\\SepomexServiceProvider"
            ],
            "aliases": {
                "Sepomex": "Wafto\\Sepomex\\Facades\\Sepomex"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
